{
    "manifest_version": 3,
    "name": "Bookmark Delight",
    "version": "1.1",
    "description": "Manage your bookmarks with ease",
    "chrome_url_overrides": {
        "newtab": "index.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "storage",
        "unlimitedStorage",
        "tabs",
        "favicon"
    ],
    "host_permissions": [
        "<all_urls>"
    ]
}